# Copy to .env.development and fill in. Local Supabase, for development (see docs/auth.md).
# `npm start` copies .env.development to .env.local, which Expo reads first.

# http://<your PC's local IP>:54321 (find it with `ipconfig`), never 127.0.0.1: on the phone
# that is the phone itself.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321

# The public key only: PUBLISHABLE_KEY from `npx supabase status`.
# Never the secret or service_role key: everything in EXPO_PUBLIC_ variables ships inside the app.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
