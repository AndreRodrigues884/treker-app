-- Shared test helpers, included at the top of each test file with \ir (inside its transaction,
-- so everything here is rolled back with the test). The .psql extension keeps pg_prove from
-- running it as a test file.

set local client_min_messages = warning;
create extension if not exists pgtap with schema extensions;

create schema tests;
grant usage on schema tests to anon, authenticated;

-- Creates a user the way Supabase Auth does; the signup trigger then creates the profile.
create function tests.create_user(p_id uuid, p_email text, p_display_name text default null)
returns uuid
language plpgsql
as $$
begin
  insert into auth.users (
    id, instance_id, aud, role, email, raw_app_meta_data, raw_user_meta_data, created_at, updated_at
  )
  values (
    p_id,
    '00000000-0000-0000-0000-000000000000',
    'authenticated',
    'authenticated',
    p_email,
    '{}'::jsonb,
    case
      when p_display_name is null then '{}'::jsonb
      else jsonb_build_object('display_name', p_display_name)
    end,
    now(),
    now()
  );
  return p_id;
end;
$$;

-- Acts as a signed-in user for the rest of the transaction: auth.uid() returns p_user_id and
-- RLS applies. Use `reset role` to go back to the test runner's role.
create function tests.authenticate_as(p_user_id uuid)
returns void
language plpgsql
as $$
begin
  perform set_config(
    'request.jwt.claims',
    jsonb_build_object('sub', p_user_id, 'role', 'authenticated')::text,
    true
  );
  perform set_config('role', 'authenticated', true);
end;
$$;

-- Acts as a visitor who is not signed in (the anon key).
create function tests.authenticate_as_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '{"role": "anon"}', true);
  perform set_config('role', 'anon', true);
end;
$$;

-- Shortcuts for writing workouts as the current user (they run with the caller's rights, so RLS
-- and triggers apply exactly as for the app).

create function tests.exercise(p_slug text)
returns uuid
language sql
stable
as $$
  select id from public.exercises where slug = p_slug;
$$;

create function tests.add_activity(
  p_type public.activity_type,
  p_local_date date,
  p_id uuid default gen_random_uuid(),
  p_bodyweight_kg numeric default null
)
returns uuid
language sql
as $$
  insert into public.activities (id, type, local_date, timezone, bodyweight_kg)
  values (p_id, p_type, p_local_date, 'Europe/Lisbon', p_bodyweight_kg)
  returning id;
$$;

create function tests.add_set(
  p_activity_id uuid,
  p_slug text,
  p_weight_kg numeric,
  p_reps integer,
  p_set_number integer default 1,
  p_is_warmup boolean default false
)
returns uuid
language sql
as $$
  insert into public.gym_sets (
    activity_id, exercise_id, exercise_position, set_number, weight_kg, reps, is_warmup
  )
  values (
    p_activity_id, tests.exercise(p_slug), 0, p_set_number, p_weight_kg, p_reps, p_is_warmup
  )
  returning id;
$$;

create function tests.add_swim(
  p_activity_id uuid,
  p_stroke public.swim_stroke,
  p_distance integer,
  p_pool_length public.pool_length,
  p_time_cs integer,
  p_kind public.swim_kind default 'race'
)
returns uuid
language sql
as $$
  insert into public.swim_entries (activity_id, stroke, distance, pool_length, time_cs, kind)
  values (p_activity_id, p_stroke, p_distance, p_pool_length, p_time_cs, p_kind)
  returning id;
$$;

-- Starts counting record rebuilds from zero (see private.count_record_rebuild).
create function tests.reset_rebuild_count()
returns void
language sql
as $$
  select set_config('treker.record_rebuilds', '0', true);
$$;

create function tests.rebuild_count()
returns integer
language sql
as $$
  select coalesce(nullif(current_setting('treker.record_rebuilds', true), ''), '0')::integer;
$$;

grant execute on all functions in schema tests to anon, authenticated;

-- Two users and one row of every table for each, created as the test runner (bypassing RLS).
-- Ids: Ana's rows start with a, Bruno's with b.
select tests.create_user('aaaaaaaa-0000-0000-0000-000000000000', 'ana@example.com', 'Ana');
select tests.create_user('bbbbbbbb-0000-0000-0000-000000000000', 'bruno@example.com');

