# Copy to .env.production and fill in. The online Supabase project (EU region).
# `npm run start:prod` copies .env.production to .env.local, which Expo reads first.

# Project URL: Supabase dashboard > Project Settings > API (or Data API).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable key only (sb_publishable_...): Project Settings > API Keys.
# Never the secret or service_role key: everything in EXPO_PUBLIC_ variables ships inside the app.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
