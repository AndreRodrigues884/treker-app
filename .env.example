# Copy to .env and fill in. See docs/auth.md.

# Development: http://<your PC's local IP>:54321 (find it with `ipconfig`, see docs/auth.md).
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321

# The public key only: PUBLISHABLE_KEY (or the legacy ANON_KEY) from `npx supabase status`.
# Never the secret or service_role key: everything in EXPO_PUBLIC_ variables ships inside the app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key
